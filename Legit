local tabButtons = {}
local tabAccents = {}
local contentPages = {}

local function selectTab(index)
	for i, btn in pairs(tabButtons) do
		local accent = tabAccents[i]
		local page = contentPages[i]
		if i == index then
			TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.SurfaceLight}):Play()
			TweenService:Create(accent, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
			btn.TextLabel.TextColor3 = Theme.TextMain
			page.Visible = true
		else
			TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Surface}):Play()
			TweenService:Create(accent, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
			btn.TextLabel.TextColor3 = Theme.TextDim
			page.Visible = false
		end
	end
end

